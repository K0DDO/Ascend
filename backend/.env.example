# Ascend API — copy to `.env` and adjust as needed.
APP_NAME=Ascend API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USER=ascend
DATABASE_PASSWORD=ascend
DATABASE_NAME=ascend
# DATABASE_URL=postgresql+asyncpg://ascend:ascend@localhost:5432/ascend

JWT_SECRET_KEY=dev-only-change-me-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
